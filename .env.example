# --- Agents (Claude Agent SDK) ---
ANTHROPIC_API_KEY=
# Model for the orchestrator and specialists
LIWAN_MODEL=claude-sonnet-5-5

# --- Database ---
LIWAN_DB=data/liwan.db

# --- Dashboard ---
PORT=8787
# Public URL (used in WhatsApp links). Use https in production so session cookies are Secure.
DASHBOARD_URL=http://localhost:8787
# Long random string: openssl rand -hex 32
SESSION_SECRET=

# --- Email (SMTP) — the 9pm summary + Sunday report to every owner with an email (see docs/email.md) ---
# Gmail / Google Workspace: smtp.gmail.com, port 465, your address, and a 16-character App Password
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="The Liwan <you@gmail.com>"

# --- WhatsApp Cloud API (Meta) — optional, runs alongside email once approved ---
# If neither email nor WhatsApp is set, summaries print to the console.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
# template = approved template with short params (works any time)
# text     = full summary as free text (only within 24h of an owner messaging the business number)
WHATSAPP_MODE=template
WHATSAPP_TEMPLATE_DAILY=liwan_daily_summary
WHATSAPP_TEMPLATE_WEEKLY=liwan_weekly_report
WHATSAPP_TEMPLATE_LANG=en
